{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "FR!sky Paperclip",
  "short_name": "Paperclip",
  "version": "0.3.1",
  "description": "The agent desk in Chrome. Grok plans. Clip clicks only after you stamp. Max 12 steps.",
  "homepage_url": "https://friskydevelopments.github.io/paperclip-chrome/",
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus", "storage", "clipboardWrite", "nativeMessaging"],
  "optional_host_permissions": ["http://127.0.0.1:7429/*", "https://api.x.ai/*"],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Paperclip desk",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/128.png" }
}
