{
  "name": "paperclip-wiki",
  "main": "worker.ts",
  "compatibility_date": "2026-09-06",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "friskydev.com/paperclip/wiki*", "zone_name": "friskydev.com" },
    { "pattern": "www.friskydev.com/paperclip/wiki*", "zone_name": "friskydev.com" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
